{
  "schemaVersion": 1,
  "id": "kuma_api",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "BlayTheNinth"
  ],
  "contact": {
    "homepage": "https://balm.twelveiterations.com/",
    "sources": "https://github.com/TwelveIterations/KumaAPI",
    "issues": "https://github.com/TwelveIterations/KumaAPI/issues"
  },
  "license": "${license}",
  "icon": "kuma_api.png",

  "environment": "*",
  "entrypoints": {
    "client": [
      "net.blay09.mods.kuma.fabric.FabricKumaAPI"
    ]
  },
  "mixins": [
    "kuma_api.mixins.json",
    "kuma_api.fabric.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/VAfZ2Nau6j"
      },
      "badges": ["library"]
    }
  }
}
